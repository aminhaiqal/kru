                "file_path": "/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-5-3-lean-full/src/duration.ts",
                "content": "export function parseDuration(text: string): number {\n  const MAX = Number.MAX_SAFE_INTEGER;\n  const MULT: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n  const ORDER: Record<string, number> = { h: 3, m: 2, s: 1, ms: 0 };\n\n  // Validate overall structure: optional whitespace, then one or more <digits><unit>\n  // separated by whitespace, then optional whitespace. Units: h, ms, m, s (ms before m).\n  if (!/^\\s*\\d+(h|ms|m|s)(\\s+\\d+(h|ms|m|s))*\\s*$/.test(text)) {\n    throw new RangeError('Invalid duration');\n  }\n\n  let total = 0;\n  let lastOrder = Infinity;\n  const componentRe = /(\\d+)(h|ms|m|s)/g;\n  let match: RegExpExecArray | null;\n\n  while ((match = componentRe.exec(text)) !== null) {\n    const unit = match[2];\n    const order = ORDER[unit];\n\n    // Units must appear in strictly descending order (no duplicates).\n    if (order >= lastOrder) throw new RangeError('Invalid duration');\n    lastOrder = order;\n\n    const value = Number(match[1]);\n    if (value > MAX) throw new RangeError('Invalid duration');\n\n    const contribution = value * MULT[unit];\n    if (contribution > MAX) throw new RangeError('Invalid duration');\n\n    total += contribution;\n    if (total > MAX) throw new RangeError('Invalid duration');\n  }\n\n  return total;\n}\n"
              }
