                "content": "export function parseDuration(text: string): number {\n  const MAX = Number.MAX_SAFE_INTEGER;\n  const MAX_STR = '9007199254740991'; // String(MAX)\n\n  // Units in strictly descending order\n  const ORDER = ['h', 'm', 's', 'ms'] as const;\n  type Unit = (typeof ORDER)[number];\n  const MULT: Record<Unit, number> = { h: 3_600_000, m: 60_000, s: 1_000, ms: 1 };\n\n  const s = text;\n  const len = s.length;\n  let pos = 0;\n\n  const isWs = (c: string) => c === ' ' || c === '\\t' || c === '\\r' || c === '\\n';\n  const skipWs = () => { while (pos < len && isWs(s[pos])) pos++; };\n  const err = (): never => { throw new RangeError('Invalid duration'); };\n\n  skipWs();\n  if (pos === len) err();\n\n  let lastOrderIdx = -1;\n  let total = 0;\n  let parsed = false;\n\n  while (pos < len) {\n    // Skip inter-component (or trailing) whitespace after first component\n    if (parsed) {\n      skipWs();\n      if (pos === len) break; // clean trailing whitespace\n    }\n\n    // Parse one or more decimal digits — no sign, no decimal point\n    if (s[pos] < '0' || s[pos] > '9') err();\n    const numStart = pos;\n    while (pos < len && s[pos] >= '0' && s[pos] <= '9') pos++;\n    const numStr = s.slice(numStart, pos);\n\n    // Parse unit immediately after digits (no whitespace allowed between)\n    let unit: Unit;\n    if (pos + 1 < len && s[pos] === 'm' && s[pos + 1] === 's') {\n      unit = 'ms'; pos += 2;\n    } else if (pos < len && s[pos] === 'h') {\n      unit = 'h'; pos++;\n    } else if (pos < len && s[pos] === 'm') {\n      unit = 'm'; pos++;\n    } else if (pos < len && s[pos] === 's') {\n      unit = 's'; pos++;\n    } else {\n      err();\n    }\n\n    // Enforce strictly descending unit order (no duplicates)\n    const orderIdx = ORDER.indexOf(unit);\n    if (orderIdx <= lastOrderIdx) err();\n    lastOrderIdx = orderIdx;\n\n    // Reject component value > MAX_SAFE_INTEGER (compare as digit strings)\n    if (numStr.length > MAX_STR.length ||\n        (numStr.length === MAX_STR.length && numStr > MAX_STR)) err();\n\n    const val = Number(numStr);\n    const mult = MULT[unit];\n\n    // Reject if val * mult would overflow MAX_SAFE_INTEGER\n    if (val > 0 && val > Math.floor(MAX / mult)) err();\n    const contribution = val * mult;\n\n    // Reject if running total would overflow MAX_SAFE_INTEGER\n    if (total > MAX - contribution) err();\n\n    total += contribution;\n    parsed = true;\n  }\n\n  if (!parsed) err();\n  return total;\n}\n"
