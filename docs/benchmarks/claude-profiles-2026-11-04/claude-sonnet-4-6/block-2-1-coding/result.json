                "content": "export function parseDuration(text: string): number {\n  const UNITS: { unit: string; mult: number }[] = [\n    { unit: 'h',  mult: 3_600_000 },\n    { unit: 'm',  mult:    60_000 },\n    { unit: 's',  mult:     1_000 },\n    { unit: 'ms', mult:         1 },\n  ];\n\n  const MAX = Number.MAX_SAFE_INTEGER;\n\n  // Strip leading/trailing whitespace then reject empty\n  const trimmed = text.trim();\n  if (trimmed === '') throw new RangeError('Invalid duration: empty input');\n\n  // ms must precede m in the alternation so the regex prefers the longer unit\n  const componentRe = /^(\\d+)(h|ms|m|s)/;\n\n  let remaining = trimmed;\n  let total = 0;\n  let lastUnitIndex = -1;\n\n  while (remaining.length > 0) {\n    const match = componentRe.exec(remaining);\n    if (!match) throw new RangeError('Invalid duration: unexpected input');\n\n    const valueStr = match[1];\n    const unitStr  = match[2];\n\n    const unitIndex = UNITS.findIndex(u => u.unit === unitStr);\n\n    // Strictly descending order (also rejects duplicates)\n    if (unitIndex <= lastUnitIndex) {\n      throw new RangeError('Invalid duration: out-of-order or duplicate unit');\n    }\n    lastUnitIndex = unitIndex;\n\n    const value = Number(valueStr);\n\n    // Guard: value itself must not exceed MAX\n    if (value > MAX) throw new RangeError('Invalid duration: component value exceeds MAX_SAFE_INTEGER');\n\n    const mult = UNITS[unitIndex].mult;\n\n    // Guard: value * mult must not exceed MAX (avoid IEEE drift by integer division)\n    if (value > Math.floor(MAX / mult)) {\n      throw new RangeError('Invalid duration: total exceeds MAX_SAFE_INTEGER');\n    }\n    const contribution = value * mult;\n\n    // Guard: running total must not exceed MAX\n    if (contribution > MAX - total) {\n      throw new RangeError('Invalid duration: total exceeds MAX_SAFE_INTEGER');\n    }\n    total += contribution;\n\n    // Consume matched text then skip optional inter-component whitespace\n    remaining = remaining.slice(match[0].length).replace(/^\\s+/, '');\n  }\n\n  // We always enter the loop at least once (trimmed is non-empty) and any\n  // failure to match a component throws, so reaching here means we parsed ≥1.\n  return total;\n}\n"
              }
