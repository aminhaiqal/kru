{"phase":"measured","value":{"method":"item/started","params":{"threadId":"f3b495dd-3794-444e-bb21-6cb9e5b907f0","turnId":"5c298e73-1169-4a06-9915-407fd16f67ad","item":{"id":"toolu_019qmFeeQN4tFNNKZKY6pm1i","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-2-2-lean-full/src/duration.ts","content":"export function parseDuration(text: string): number {\n  // Full-string pattern: optional leading/trailing whitespace, one or more\n  // components (digits immediately followed by a unit), optional whitespace\n  // between components. Units tried longest-first so \"ms\" beats \"m\".\n  const FULL = /^\\s*\\d+(?:ms|h|m|s)(?:\\s*\\d+(?:ms|h|m|s))*\\s*$/;\n  if (!FULL.test(text)) throw new RangeError('Invalid duration');\n\n  const COMPONENT = /\\d+(?:ms|h|m|s)/g;\n  const components = text.match(COMPONENT)!;\n\n  const ORDER: Record<string, number> = { h: 0, m: 1, s: 2, ms: 3 };\n  const MULT: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n  const MAX = Number.MAX_SAFE_INTEGER;\n\n  let lastOrder = -1;\n  let total = 0;\n\n  for (const comp of components) {\n    const unit = comp.endsWith('ms') ? 'ms' : comp.slice(-1);\n    const numStr = unit === 'ms' ? comp.slice(0, -2) : comp.slice(0, -1);\n\n    // Strictly descending order (also rejects duplicates)\n    const ord = ORDER[unit];\n    if (ord <= lastOrder) throw new RangeError('Invalid duration');\n    lastOrder = ord;\n\n    const value = Number(numStr);\n    if (value > MAX) throw new RangeError('Invalid duration');\n\n    const contribution = value * MULT[unit];\n    if (contribution > MAX) throw new RangeError('Invalid duration');\n\n    total += contribution;\n    if (total > MAX) throw new RangeError('Invalid duration');\n  }\n\n  return total;\n}\n"}}}}}}
