                "content": "const ORDER = { h: 0, m: 1, s: 2, ms: 3 } as const;\nconst MULT  = { h: 3600000, m: 60000, s: 1000, ms: 1 } as const;\n\nexport function parseDuration(text: string): number {\n  let pos = 0;\n  let lastOrder = -1;\n  let total = 0;\n  let found = false;\n\n  while (pos < text.length && (text[pos] === ' ' || text[pos] === '\\t')) pos++;\n\n  while (pos < text.length) {\n    const m = /^(\\d+)(h|ms|m|s)/.exec(text.slice(pos));\n    if (!m) throw new RangeError('Invalid duration');\n\n    found = true;\n    const unit = m[2] as keyof typeof ORDER;\n    const ord = ORDER[unit];\n\n    if (ord <= lastOrder) throw new RangeError('Invalid duration');\n    lastOrder = ord;\n\n    const val = Number(m[1]);\n    if (!Number.isSafeInteger(val)) throw new RangeError('Invalid duration');\n\n    total += val * MULT[unit];\n    if (!Number.isSafeInteger(total)) throw new RangeError('Invalid duration');\n\n    pos += m[0].length;\n    while (pos < text.length && (text[pos] === ' ' || text[pos] === '\\t')) pos++;\n  }\n\n  if (!found) throw new RangeError('Invalid duration');\n  return total;\n}\n"
              }
