                "file_path": "/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-2-3-full-restricted/src/duration.ts",
                "content": "export function parseDuration(text: string): number {\n  const UNITS: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n  const UNIT_ORDER: Record<string, number> = { h: 3, m: 2, s: 1, ms: 0 };\n\n  if (!/^\\s*\\d+(?:h|ms|m|s)(?:\\s*\\d+(?:h|ms|m|s))*\\s*$/.test(text)) {\n    throw new RangeError('Invalid duration');\n  }\n\n  const componentRe = /(\\d+)(h|ms|m|s)/g;\n  let total = 0;\n  let lastOrder = Infinity;\n  let match;\n\n  while ((match = componentRe.exec(text)) !== null) {\n    const value = Number(match[1]);\n    const unit = match[2];\n    const order = UNIT_ORDER[unit];\n\n    if (order >= lastOrder) throw new RangeError('Invalid duration');\n    if (value > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    const ms = value * UNITS[unit];\n    if (ms > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    total += ms;\n    if (total > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    lastOrder = order;\n  }\n\n  return total;\n}\n"
              }
            }
          }
        }
