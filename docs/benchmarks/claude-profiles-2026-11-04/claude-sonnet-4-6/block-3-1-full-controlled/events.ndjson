{"phase":"measured","value":{"method":"item/started","params":{"threadId":"cbcd66cf-e695-48b9-afd7-8e5497d6d6a3","turnId":"d034f6a3-2b3b-4f94-b8b4-5c603a595334","item":{"id":"toolu_01XTZUkKVNGCUHkRVeRCDvGj","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-3-1-full-controlled/src/duration.ts","content":"export function parseDuration(text: string): number {\n  const MAX = Number.MAX_SAFE_INTEGER;\n  const re = /^\\s*(?:(\\d+)h\\s*)?(?:(\\d+)m(?!s)\\s*)?(?:(\\d+)s\\s*)?(?:(\\d+)ms\\s*)?$/;\n  const match = re.exec(text);\n  if (!match) throw new RangeError('Invalid duration');\n\n  const [, h, m, s, ms] = match;\n  if (h === undefined && m === undefined && s === undefined && ms === undefined) {\n    throw new RangeError('Invalid duration');\n  }\n\n  const components: Array<[string | undefined, number]> = [\n    [h, 3600000],\n    [m, 60000],\n    [s, 1000],\n    [ms, 1],\n  ];\n\n  let total = 0;\n  for (const [raw, multiplier] of components) {\n    if (raw === undefined) continue;\n    const val = Number(raw);\n    if (val > MAX) throw new RangeError('Invalid duration');\n    const contribution = val * multiplier;\n    if (contribution > MAX - total) throw new RangeError('Invalid duration');\n    total += contribution;\n  }\n\n  return total;\n}\n"}}}}}}
