                "content": "export function parseDuration(text: string): number {\n  const MAX = Number.MAX_SAFE_INTEGER;\n  const s = text.trim();\n  if (s.length === 0) throw new RangeError('Invalid duration');\n\n  let pos = 0;\n  let total = 0;\n  let lastUnit = -1;\n  let count = 0;\n\n  while (pos < s.length) {\n    // Parse decimal digits only (no sign, no decimal point)\n    const digitStart = pos;\n    while (pos < s.length && s[pos] >= '0' && s[pos] <= '9') pos++;\n    if (pos === digitStart) throw new RangeError('Invalid duration');\n    const numStr = s.slice(digitStart, pos);\n\n    // Parse unit: check 'ms' before 'm'/'s' to avoid prefix ambiguity\n    let unitOrder: number;\n    let unitMs: number;\n    if (s.slice(pos, pos + 2) === 'ms') {\n      unitOrder = 3; unitMs = 1; pos += 2;\n    } else if (s[pos] === 'h') {\n      unitOrder = 0; unitMs = 3_600_000; pos++;\n    } else if (s[pos] === 'm') {\n      unitOrder = 1; unitMs = 60_000; pos++;\n    } else if (s[pos] === 's') {\n      unitOrder = 2; unitMs = 1_000; pos++;\n    } else {\n      throw new RangeError('Invalid duration');\n    }\n\n    // Enforce strictly descending unit order (rejects duplicates and out-of-order)\n    if (unitOrder <= lastUnit) throw new RangeError('Invalid duration');\n    lastUnit = unitOrder;\n\n    // Validate the parsed integer value\n    const val = Number(numStr);\n    if (val > MAX) throw new RangeError('Invalid duration');\n\n    // Validate the component's millisecond contribution won't overflow\n    if (unitMs > 1 && val > Math.floor(MAX / unitMs)) throw new RangeError('Invalid duration');\n    const contrib = val * unitMs;\n\n    // Validate running total\n    if (total > MAX - contrib) throw new RangeError('Invalid duration');\n    total += contrib;\n    count++;\n\n    // Skip optional whitespace between components (not between digit and unit)\n    while (pos < s.length && /\\s/.test(s[pos])) pos++;\n  }\n\n  if (count === 0) throw new RangeError('Invalid duration');\n  return total;\n}\n"
