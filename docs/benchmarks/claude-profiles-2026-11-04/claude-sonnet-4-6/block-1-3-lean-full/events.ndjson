{"phase":"measured","value":{"method":"item/started","params":{"threadId":"fe0e862b-f2db-41da-abea-18cd0f161882","turnId":"9ad44d9f-29da-425b-841f-40e88a45feb8","item":{"id":"toolu_01QPE8PkY1rWtoRH6GycPmpn","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-1-3-lean-full/src/duration.ts","content":"export function parseDuration(text: string): number {\n  const trimmed = text.trim();\n  if (!trimmed) throw new RangeError('Invalid duration');\n\n  // Validate: one or more components (digits + unit), separated by optional whitespace.\n  // ms must precede m in the alternation so \"ms\" is tried first.\n  if (!/^\\d+(?:h|ms|m|s)(?:\\s*\\d+(?:h|ms|m|s))*$/.test(trimmed)) {\n    throw new RangeError('Invalid duration');\n  }\n\n  const unitOrder = ['h', 'm', 's', 'ms'];\n  const unitMultipliers: Record<string, number> = {\n    h: 3_600_000,\n    m:    60_000,\n    s:     1_000,\n    ms:        1,\n  };\n\n  const tokenRegex = /(\\d+)(h|ms|m|s)/g;\n  let total = 0;\n  let lastUnitIndex = -1;\n  let match: RegExpExecArray | null;\n\n  while ((match = tokenRegex.exec(trimmed)) !== null) {\n    const unit = match[2];\n    const unitIndex = unitOrder.indexOf(unit);\n\n    // Units must appear in strictly descending order (no repeats, no going back).\n    if (unitIndex <= lastUnitIndex) throw new RangeError('Invalid duration');\n    lastUnitIndex = unitIndex;\n\n    const value = Number(match[1]);\n    if (!Number.isSafeInteger(value)) throw new RangeError('Invalid duration');\n\n    const contribution = value * unitMultipliers[unit];\n    if (!Number.isSafeInteger(contribution)) throw new RangeError('Invalid duration');\n\n    total += contribution;\n    if (!Number.isSafeInteger(total)) throw new RangeError('Invalid duration');\n  }\n\n  return total;\n}\n"}}}}}}
