                "content": "export function parseDuration(text: string): number {\n  if (!/^\\s*\\d+(?:h|ms|s|m)(?:\\s*\\d+(?:h|ms|s|m))*\\s*$/.test(text)) {\n    throw new RangeError('Invalid duration');\n  }\n\n  const mult: Record<string, number> = { h: 3_600_000, m: 60_000, s: 1_000, ms: 1 };\n  const rank: Record<string, number> = { h: 3, m: 2, s: 1, ms: 0 };\n\n  const re = /(\\d+)(h|ms|s|m)/g;\n  let total = 0;\n  let prevRank = Infinity;\n  let match: RegExpExecArray | null;\n\n  while ((match = re.exec(text)) !== null) {\n    const value = Number(match[1]);\n    const unit = match[2];\n\n    if (value > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n    if (rank[unit] >= prevRank) throw new RangeError('Invalid duration');\n\n    const contribution = value * mult[unit];\n    if (contribution > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    total += contribution;\n    if (total > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    prevRank = rank[unit];\n  }\n\n  return total;\n}\n"
              }
            }
          }
