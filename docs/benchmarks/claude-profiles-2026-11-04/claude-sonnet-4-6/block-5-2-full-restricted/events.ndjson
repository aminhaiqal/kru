{"phase":"measured","value":{"method":"item/started","params":{"threadId":"855d2349-9145-406b-a031-c2d5c290fb9c","turnId":"b8000a1c-6897-4978-841f-8a799a7b6b44","item":{"id":"toolu_01P7wfQFUQHsoaFguAnphAhr","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-5-2-full-restricted/src/duration.ts","content":"export function parseDuration(text: string): number {\n  if (!/^\\s*\\d+(?:h|ms|s|m)(?:\\s*\\d+(?:h|ms|s|m))*\\s*$/.test(text)) {\n    throw new RangeError('Invalid duration');\n  }\n\n  const mult: Record<string, number> = { h: 3_600_000, m: 60_000, s: 1_000, ms: 1 };\n  const rank: Record<string, number> = { h: 3, m: 2, s: 1, ms: 0 };\n\n  const re = /(\\d+)(h|ms|s|m)/g;\n  let total = 0;\n  let prevRank = Infinity;\n  let match: RegExpExecArray | null;\n\n  while ((match = re.exec(text)) !== null) {\n    const value = Number(match[1]);\n    const unit = match[2];\n\n    if (value > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n    if (rank[unit] >= prevRank) throw new RangeError('Invalid duration');\n\n    const contribution = value * mult[unit];\n    if (contribution > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    total += contribution;\n    if (total > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    prevRank = rank[unit];\n  }\n\n  return total;\n}\n"}}}}}}
