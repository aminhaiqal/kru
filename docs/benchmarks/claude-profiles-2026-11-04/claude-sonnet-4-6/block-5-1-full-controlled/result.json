                "content": "export function parseDuration(text: string): number {\n  const unitOrder: Record<string, number> = { h: 0, m: 1, s: 2, ms: 3 };\n  const unitMs: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n  const componentRe = /^(\\d+)(h|ms|m|s)/;\n\n  const trimmed = text.trim();\n  if (!trimmed) throw new RangeError('Invalid duration');\n\n  let remaining = trimmed;\n  let total = 0;\n  let lastOrder = -1;\n  let parsed = false;\n\n  while (remaining.length > 0) {\n    remaining = remaining.replace(/^\\s+/, '');\n    if (!remaining) break;\n\n    const match = componentRe.exec(remaining);\n    if (!match) throw new RangeError('Invalid duration');\n\n    const unit = match[2];\n    const order = unitOrder[unit];\n    if (order <= lastOrder) throw new RangeError('Invalid duration');\n    lastOrder = order;\n\n    const value = Number(match[1]);\n    if (!Number.isSafeInteger(value)) throw new RangeError('Invalid duration');\n\n    const ms = value * unitMs[unit];\n    if (!Number.isSafeInteger(ms)) throw new RangeError('Invalid duration');\n\n    total += ms;\n    if (!Number.isSafeInteger(total)) throw new RangeError('Invalid duration');\n\n    parsed = true;\n    remaining = remaining.slice(match[0].length);\n  }\n\n  if (!parsed) throw new RangeError('Invalid duration');\n  return total;\n}\n"
              }
            }
