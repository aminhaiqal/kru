{"phase":"measured","value":{"method":"item/started","params":{"threadId":"332ed25c-b68a-4532-b37f-30e8cfcc3134","turnId":"c63f8065-2f4f-420f-82a7-4ac1de2dfd4c","item":{"id":"toolu_01VkgB6niBSR9UpFhwQ4igJT","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-1-2-full-restricted/src/duration.ts","content":"const UNITS = ['h', 'm', 's', 'ms'] as const;\ntype Unit = (typeof UNITS)[number];\nconst MS: Record<Unit, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\nconst COMPONENT_RE = /^(\\d+)(h|ms|m|s)/;\nconst MAX = Number.MAX_SAFE_INTEGER;\n\nexport function parseDuration(text: string): number {\n  let pos = /^\\s*/.exec(text)![0].length;\n  let lastUnitIndex = -1;\n  let total = 0;\n  let parsed = false;\n\n  while (pos < text.length) {\n    const match = COMPONENT_RE.exec(text.slice(pos));\n    if (!match) throw new RangeError('Invalid duration');\n\n    const value = Number(match[1]);\n    if (value > MAX) throw new RangeError('Invalid duration');\n\n    const unit = match[2] as Unit;\n    const unitIndex = UNITS.indexOf(unit);\n    if (unitIndex <= lastUnitIndex) throw new RangeError('Invalid duration');\n    lastUnitIndex = unitIndex;\n\n    const contribution = value * MS[unit];\n    if (contribution > MAX) throw new RangeError('Invalid duration');\n    total += contribution;\n    if (total > MAX) throw new RangeError('Invalid duration');\n\n    pos += match[0].length;\n    parsed = true;\n    pos += /^\\s*/.exec(text.slice(pos))![0].length;\n  }\n\n  if (!parsed) throw new RangeError('Invalid duration');\n  return total;\n}\n"}}}}}}
