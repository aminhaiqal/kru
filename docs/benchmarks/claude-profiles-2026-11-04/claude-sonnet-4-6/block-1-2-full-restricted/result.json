                "content": "const UNITS = ['h', 'm', 's', 'ms'] as const;\ntype Unit = (typeof UNITS)[number];\nconst MS: Record<Unit, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\nconst COMPONENT_RE = /^(\\d+)(h|ms|m|s)/;\nconst MAX = Number.MAX_SAFE_INTEGER;\n\nexport function parseDuration(text: string): number {\n  let pos = /^\\s*/.exec(text)![0].length;\n  let lastUnitIndex = -1;\n  let total = 0;\n  let parsed = false;\n\n  while (pos < text.length) {\n    const match = COMPONENT_RE.exec(text.slice(pos));\n    if (!match) throw new RangeError('Invalid duration');\n\n    const value = Number(match[1]);\n    if (value > MAX) throw new RangeError('Invalid duration');\n\n    const unit = match[2] as Unit;\n    const unitIndex = UNITS.indexOf(unit);\n    if (unitIndex <= lastUnitIndex) throw new RangeError('Invalid duration');\n    lastUnitIndex = unitIndex;\n\n    const contribution = value * MS[unit];\n    if (contribution > MAX) throw new RangeError('Invalid duration');\n    total += contribution;\n    if (total > MAX) throw new RangeError('Invalid duration');\n\n    pos += match[0].length;\n    parsed = true;\n    pos += /^\\s*/.exec(text.slice(pos))![0].length;\n  }\n\n  if (!parsed) throw new RangeError('Invalid duration');\n  return total;\n}\n"
