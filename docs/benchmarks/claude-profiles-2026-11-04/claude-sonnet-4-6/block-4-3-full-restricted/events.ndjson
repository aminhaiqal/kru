{"phase":"measured","value":{"method":"item/started","params":{"threadId":"48b569da-1656-4c92-8712-ce0152c75f0c","turnId":"5916ddd7-cd6d-4d3e-978f-9be3ad38ff40","item":{"id":"toolu_01CocqdshqwsjEt32s3ESJ64","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-4-3-full-restricted/src/duration.ts","content":"const UNIT_ORDER: Record<string, number> = { h: 0, m: 1, s: 2, ms: 3 };\nconst UNIT_MS: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\nconst COMPONENT_RE = /^(\\d+)(h|ms|m|s)/;\n\nexport function parseDuration(text: string): number {\n  let remaining = text.replace(/^\\s+/, '');\n  if (!remaining) throw new RangeError('Invalid duration');\n\n  let lastIndex = -1;\n  let total = 0;\n  let matched = false;\n\n  while (remaining.length > 0) {\n    const m = COMPONENT_RE.exec(remaining);\n    if (!m) throw new RangeError('Invalid duration');\n\n    const unit = m[2];\n    const idx = UNIT_ORDER[unit];\n    if (idx <= lastIndex) throw new RangeError('Invalid duration');\n    lastIndex = idx;\n\n    const value = Number(m[1]);\n    const ms = value * UNIT_MS[unit];\n    if (ms > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    total += ms;\n    if (total > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    matched = true;\n    remaining = remaining.slice(m[0].length).replace(/^\\s+/, '');\n  }\n\n  if (!matched) throw new RangeError('Invalid duration');\n  return total;\n}\n"}}}}}}
