{"phase":"measured","value":{"method":"item/started","params":{"threadId":"ccad2514-0f84-48c8-9a22-944d83280ceb","turnId":"c652e0e8-6ddb-4480-9d93-180fe8831035","item":{"id":"toolu_01H1oPjC7GhhoeAt4yD9uZEd","type":"tool","text":"Edit","details":{"name":"Edit","input":{"replace_all":false,"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-2-4-full-controlled/src/duration.ts","old_string":"export function parseDuration(text: string): number {\n  const match = /^(d+)ms$/.exec(text);\n  if (!match) throw new RangeError('Invalid duration');\n  return Number(match[1]);\n}","new_string":"export function parseDuration(text: string): number {\n  const trimmed = text.trim();\n  if (!trimmed) throw new RangeError('Invalid duration');\n\n  const unitOrder = ['h', 'm', 's', 'ms'] as const;\n  const unitMs: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n\n  const componentRe = /(\\d+)(h|ms|m|s)/y;\n  const wsRe = /\\s*/y;\n\n  let pos = 0;\n  let lastUnitIndex = -1;\n  let total = 0;\n  let hasComponent = false;\n\n  while (pos < trimmed.length) {\n    componentRe.lastIndex = pos;\n    const match = componentRe.exec(trimmed);\n    if (!match) throw new RangeError('Invalid duration');\n\n    hasComponent = true;\n    const unit = match[2] as typeof unitOrder[number];\n    pos = componentRe.lastIndex;\n\n    const unitIndex = unitOrder.indexOf(unit);\n    if (unitIndex <= lastUnitIndex) throw new RangeError('Invalid duration');\n    lastUnitIndex = unitIndex;\n\n    const value = Number(match[1]);\n    if (!Number.isSafeInteger(value)) throw new RangeError('Invalid duration');\n\n    const contribution = value * unitMs[unit];\n    if (!Number.isSafeInteger(contribution)) throw new RangeError('Invalid duration');\n\n    total += contribution;\n    if (!Number.isSafeInteger(total)) throw new RangeError('Invalid duration');\n\n    wsRe.lastIndex = pos;\n    wsRe.exec(trimmed);\n    pos = wsRe.lastIndex;\n  }\n\n  if (!hasComponent) throw new RangeError('Invalid duration');\n\n  return total;\n}"}}}}}}
