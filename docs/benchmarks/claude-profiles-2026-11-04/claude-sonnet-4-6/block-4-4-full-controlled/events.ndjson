{"phase":"measured","value":{"method":"item/started","params":{"threadId":"8879eba0-8d0b-4df4-8e58-7a9373e7c68b","turnId":"eb1e5ca8-5a91-4ac6-b6ae-9e0d37a5d945","item":{"id":"toolu_013Mj6MKNndNnNgxQt6ynZ94","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-4-4-full-controlled/src/duration.ts","content":"const UNITS = ['h', 'm', 's', 'ms'] as const;\nconst MULTIPLIERS: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n\nexport function parseDuration(text: string): number {\n  const trimmed = text.trim();\n  if (!trimmed) throw new RangeError('Invalid duration');\n\n  let pos = 0;\n  let lastUnitIndex = -1;\n  let total = 0;\n  let seenAny = false;\n\n  while (pos < trimmed.length) {\n    // skip whitespace between components\n    while (pos < trimmed.length && trimmed[pos] === ' ') pos++;\n    if (pos >= trimmed.length) break;\n\n    // read digits (no sign, no fraction)\n    const numStart = pos;\n    while (pos < trimmed.length && trimmed[pos] >= '0' && trimmed[pos] <= '9') pos++;\n    if (pos === numStart) throw new RangeError('Invalid duration');\n\n    const value = Number(trimmed.slice(numStart, pos));\n    if (value > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    // read unit (try ms before m to avoid partial match)\n    let unit: string;\n    if (trimmed.startsWith('ms', pos)) {\n      unit = 'ms';\n      pos += 2;\n    } else if (pos < trimmed.length && (trimmed[pos] === 'h' || trimmed[pos] === 'm' || trimmed[pos] === 's')) {\n      unit = trimmed[pos];\n      pos++;\n    } else {\n      throw new RangeError('Invalid duration');\n    }\n\n    const unitIndex = UNITS.indexOf(unit as typeof UNITS[number]);\n    if (unitIndex <= lastUnitIndex) throw new RangeError('Invalid duration');\n    lastUnitIndex = unitIndex;\n\n    total += value * MULTIPLIERS[unit];\n    if (total > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    seenAny = true;\n  }\n\n  if (!seenAny) throw new RangeError('Invalid duration');\n  return total;\n}\n"}}}}}}
