{"phase":"measured","value":{"method":"item/started","params":{"threadId":"d3f5cff8-bb29-4c38-8a06-910b9817e7be","turnId":"319cfe11-c8b1-40aa-b042-7f9d6ab7edcb","item":{"id":"toolu_0155YPCTnKsKSsoh8yUw6hYT","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-v2/claude-sonnet-4-6/block-4-2-lean-full/src/duration.ts","content":"export function parseDuration(text: string): number {\n  const MAX = Number.MAX_SAFE_INTEGER;\n  const unitOrder = ['h', 'm', 's', 'ms'] as const;\n  const multiplier: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n  // Max component value such that value * multiplier <= MAX\n  const maxComp: Record<string, number> = {\n    h: Math.floor(MAX / 3600000),\n    m: Math.floor(MAX / 60000),\n    s: Math.floor(MAX / 1000),\n    ms: MAX,\n  };\n\n  // Match digits immediately followed by a unit; ms before m to avoid partial match\n  const componentRe = /^(\\d+)(h|ms|s|m)/;\n\n  let s = text.replace(/^\\s+/, '');\n  if (!s) throw new RangeError('Invalid duration');\n\n  let total = 0;\n  let lastUnitIdx = -1;\n  let count = 0;\n\n  while (s.length > 0) {\n    const m = componentRe.exec(s);\n    if (!m) throw new RangeError('Invalid duration');\n\n    const unit = m[2];\n    const uIdx = unitOrder.indexOf(unit as typeof unitOrder[number]);\n\n    // Units must appear in strictly descending order (no duplicates, no out-of-order)\n    if (uIdx <= lastUnitIdx) throw new RangeError('Invalid duration');\n    lastUnitIdx = uIdx;\n\n    const value = Number(m[1]);\n\n    // Reject component values that would overflow when multiplied\n    if (value > maxComp[unit]) throw new RangeError('Invalid duration');\n\n    const contrib = value * multiplier[unit];\n\n    // Reject if running total would exceed MAX_SAFE_INTEGER\n    if (total > MAX - contrib) throw new RangeError('Invalid duration');\n    total += contrib;\n    count++;\n\n    // Advance past matched component, strip optional whitespace\n    s = s.slice(m[0].length).replace(/^\\s+/, '');\n  }\n\n  if (count === 0) throw new RangeError('Invalid duration');\n  return total;\n}\n"}}}}}}
