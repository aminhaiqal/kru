                "content": "export function parseDuration(text: string): number {\n  const multipliers: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n  // unit order index: h=0, m=1, s=2, ms=3\n  const unitOrder: Record<string, number> = { h: 0, m: 1, s: 2, ms: 3 };\n\n  const s = text.trim();\n  if (!s) throw new RangeError('Invalid duration');\n\n  let pos = 0;\n  let total = 0;\n  let lastOrder = -1;\n  let count = 0;\n\n  while (pos < s.length) {\n    // skip inter-component spaces\n    while (pos < s.length && s[pos] === ' ') pos++;\n    if (pos >= s.length) break;\n\n    // parse digits\n    const start = pos;\n    while (pos < s.length && s[pos] >= '0' && s[pos] <= '9') pos++;\n    if (pos === start) throw new RangeError('Invalid duration');\n    const numStr = s.slice(start, pos);\n\n    // parse unit (ms before s to avoid partial match)\n    let unit: string;\n    if (s.startsWith('ms', pos)) { unit = 'ms'; pos += 2; }\n    else if (s[pos] === 'h') { unit = 'h'; pos += 1; }\n    else if (s[pos] === 'm') { unit = 'm'; pos += 1; }\n    else if (s[pos] === 's') { unit = 's'; pos += 1; }\n    else throw new RangeError('Invalid duration');\n\n    // strictly descending order\n    const order = unitOrder[unit];\n    if (order <= lastOrder) throw new RangeError('Invalid duration');\n    lastOrder = order;\n\n    const val = Number(numStr);\n    if (!Number.isSafeInteger(val)) throw new RangeError('Invalid duration');\n\n    const contribution = val * multipliers[unit];\n    if (contribution > Number.MAX_SAFE_INTEGER) throw new RangeError('Invalid duration');\n\n    total += contribution;\n    if (!Number.isSafeInteger(total)) throw new RangeError('Invalid duration');\n\n    count++;\n  }\n\n  if (count === 0) throw new RangeError('Invalid duration');\n  return total;\n}\n"
              }
            }
