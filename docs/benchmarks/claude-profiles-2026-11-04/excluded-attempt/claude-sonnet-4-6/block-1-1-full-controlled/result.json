                "content": "export function parseDuration(text: string): number {\n  const MAX = Number.MAX_SAFE_INTEGER;\n  const unitMult: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n  const unitOrder = ['h', 'm', 's', 'ms'];\n\n  const stripped = text.trim();\n  if (!stripped) throw new RangeError('Invalid duration');\n\n  if (stripped.replace(/\\d+(ms|[hms])/g, '').trim() !== '')\n    throw new RangeError('Invalid duration');\n\n  const compRe = /(\\d+)(ms|[hms])/g;\n  let lastUnitIdx = -1;\n  let total = 0;\n\n  for (let m = compRe.exec(stripped); m !== null; m = compRe.exec(stripped)) {\n    const unit = m[2];\n    const unitIdx = unitOrder.indexOf(unit);\n\n    if (unitIdx <= lastUnitIdx) throw new RangeError('Invalid duration');\n    lastUnitIdx = unitIdx;\n\n    const val = Number(m[1]);\n    const contribution = val * unitMult[unit];\n\n    if (contribution > MAX || total + contribution > MAX)\n      throw new RangeError('Invalid duration');\n\n    total += contribution;\n  }\n\n  return total;\n}\n"
              }
            }
          }
