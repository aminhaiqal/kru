{"phase":"measured","value":{"method":"item/started","params":{"threadId":"876cd661-b582-43e7-82dc-b43a223af1ad","turnId":"41a20ba3-7e83-43e2-8979-871b5e938782","item":{"id":"toolu_01NQXiSQJ1Q1N6DfnJSvJak1","type":"tool","text":"Write","details":{"name":"Write","input":{"file_path":"/Users/aminh/Documents/s_work/kru/.kru/benchmarks/factorial-2026-11-04-live/claude-sonnet-4-6/block-1-1-full-controlled/src/duration.ts","content":"export function parseDuration(text: string): number {\n  const MAX = Number.MAX_SAFE_INTEGER;\n  const unitMult: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\n  const unitOrder = ['h', 'm', 's', 'ms'];\n\n  const stripped = text.trim();\n  if (!stripped) throw new RangeError('Invalid duration');\n\n  if (stripped.replace(/\\d+(ms|[hms])/g, '').trim() !== '')\n    throw new RangeError('Invalid duration');\n\n  const compRe = /(\\d+)(ms|[hms])/g;\n  let lastUnitIdx = -1;\n  let total = 0;\n\n  for (let m = compRe.exec(stripped); m !== null; m = compRe.exec(stripped)) {\n    const unit = m[2];\n    const unitIdx = unitOrder.indexOf(unit);\n\n    if (unitIdx <= lastUnitIdx) throw new RangeError('Invalid duration');\n    lastUnitIdx = unitIdx;\n\n    const val = Number(m[1]);\n    const contribution = val * unitMult[unit];\n\n    if (contribution > MAX || total + contribution > MAX)\n      throw new RangeError('Invalid duration');\n\n    total += contribution;\n  }\n\n  return total;\n}\n"}}}}}}
