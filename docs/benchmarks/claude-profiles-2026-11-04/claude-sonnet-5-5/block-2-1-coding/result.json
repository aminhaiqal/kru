                "content": "const PATTERN =\n  /^\\s*(?:([0-9]+)h\\s*)?(?:([0-9]+)m\\s*)?(?:([0-9]+)s\\s*)?(?:([0-9]+)ms\\s*)?$/;\nconst FACTORS = [3600000n, 60000n, 1000n, 1n];\nconst MAX = BigInt(Number.MAX_SAFE_INTEGER);\n\nexport function parseDuration(text: string): number {\n  const match = typeof text === 'string' ? PATTERN.exec(text) : null;\n  if (!match || match.slice(1).every((part) => part === undefined)) {\n    throw new RangeError('Invalid duration');\n  }\n  let total = 0n;\n  for (let i = 0; i < FACTORS.length; i++) {\n    const part = match[i + 1];\n    if (part === undefined) continue;\n    total += BigInt(part) * FACTORS[i];\n    if (total > MAX) throw new RangeError('Duration exceeds safe integer range');\n  }\n  return Number(total);\n}\n"
              }
