                "content": "const UNITS = ['h', 'm', 's', 'ms'] as const;\nconst MULTIPLIERS: Record<string, bigint> = {\n  h: 3600000n,\n  m: 60000n,\n  s: 1000n,\n  ms: 1n,\n};\nconst MAX = BigInt(Number.MAX_SAFE_INTEGER);\n\nexport function parseDuration(text: string): number {\n  if (typeof text !== 'string') throw new RangeError('Invalid duration');\n  const re = /\\s*(\\d+)(ms|h|m|s)/y;\n  const end = text.trimEnd().length;\n  let pos = 0;\n  let lastIndex = -1;\n  let total = 0n;\n  let count = 0;\n\n  while (pos < end) {\n    re.lastIndex = pos;\n    const match = re.exec(text);\n    if (!match || re.lastIndex > end) throw new RangeError('Invalid duration');\n    const idx = UNITS.indexOf(match[2] as (typeof UNITS)[number]);\n    if (idx <= lastIndex) throw new RangeError('Invalid duration');\n    lastIndex = idx;\n    const value = BigInt(match[1]);\n    if (value > MAX) throw new RangeError('Duration too large');\n    total += value * MULTIPLIERS[match[2]];\n    if (total > MAX) throw new RangeError('Duration too large');\n    pos = re.lastIndex;\n    count++;\n  }\n\n  if (count === 0) throw new RangeError('Invalid duration');\n  return Number(total);\n}\n"
              }
