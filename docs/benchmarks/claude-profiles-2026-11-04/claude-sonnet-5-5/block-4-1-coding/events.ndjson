{"phase":"measured","value":{"method":"item/started","params":{"threadId":"d0114184-c89c-42af-b6b9-18280b75469c","turnId":"08d9377d-564f-4e2f-88b2-5121c35fac56","item":{"id":"toolu_01DxJdhhqrD7FRVVce9bV3Di","type":"commandExecution","text":"Bash","details":{"name":"Bash","input":{"command":"cat > src/duration.ts <<'EOF'\nconst PATTERN = /^\\s*(?:(\\d+)h\\s*)?(?:(\\d+)m(?!s)\\s*)?(?:(\\d+)s\\s*)?(?:(\\d+)ms\\s*)?$/;\nconst MULTIPLIERS = [3600000n, 60000n, 1000n, 1n];\n\nexport function parseDuration(text: string): number {\n  const match = PATTERN.exec(text);\n  if (!match || match.slice(1).every((part) => part === undefined)) {\n    throw new RangeError('Invalid duration');\n  }\n  const max = BigInt(Number.MAX_SAFE_INTEGER);\n  let total = 0n;\n  for (let i = 0; i < 4; i++) {\n    const part = match[i + 1];\n    if (part !== undefined) total += BigInt(part) * MULTIPLIERS[i];\n  }\n  if (total > max) throw new RangeError('Duration exceeds maximum safe integer');\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -15"}}}}}}
