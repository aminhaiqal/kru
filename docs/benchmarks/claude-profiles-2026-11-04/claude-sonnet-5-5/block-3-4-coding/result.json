                "command": "cat > src/duration.ts <<'EOF'\nconst UNITS = ['h', 'm', 's', 'ms'] as const;\nconst FACTORS: Record<(typeof UNITS)[number], bigint> = {\n  h: 3600000n,\n  m: 60000n,\n  s: 1000n,\n  ms: 1n,\n};\nconst MAX = BigInt(Number.MAX_SAFE_INTEGER);\n\nexport function parseDuration(text: string): number {\n  if (typeof text !== 'string') throw new RangeError('Invalid duration');\n  const re = /\\s*(\\d+)(ms|h|m|s)/y;\n  let pos = 0;\n  let lastIndex = -1;\n  let total = 0n;\n  let count = 0;\n  const end = text.trimEnd().length;\n  while (pos < end) {\n    re.lastIndex = pos;\n    const match = re.exec(text);\n    if (!match) throw new RangeError('Invalid duration');\n    const unit = match[2] as (typeof UNITS)[number];\n    const idx = UNITS.indexOf(unit);\n    if (idx <= lastIndex) throw new RangeError('Invalid duration');\n    lastIndex = idx;\n    const value = BigInt(match[1]);\n    if (value > MAX) throw new RangeError('Duration too large');\n    total += value * FACTORS[unit];\n    if (total > MAX) throw new RangeError('Duration too large');\n    pos = re.lastIndex;\n    count++;\n  }\n  if (count === 0) throw new RangeError('Invalid duration');\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -15"
