{"phase":"measured","value":{"method":"item/started","params":{"threadId":"871fb90f-a1ca-4da2-a1cd-bf9f0b9ba7a4","turnId":"1416a5a2-fab0-4407-9f6f-678f04b331b2","item":{"id":"toolu_01HuZwjMA7LfPoSJcy5bnCwd","type":"commandExecution","text":"Bash","details":{"name":"Bash","input":{"command":"cat > src/duration.ts <<'EOF'\nconst UNITS: Record<string, [number, bigint]> = {\n  h: [0, 3600000n],\n  m: [1, 60000n],\n  s: [2, 1000n],\n  ms: [3, 1n],\n};\n\nexport function parseDuration(text: string): number {\n  const token = /\\s*(\\d+)(ms|h|m|s)/y;\n  const end = /\\s*$/y;\n  const max = BigInt(Number.MAX_SAFE_INTEGER);\n  let pos = 0;\n  let last = -1;\n  let total = 0n;\n  while (true) {\n    token.lastIndex = pos;\n    const match = token.exec(text);\n    if (!match) break;\n    const [order, factor] = UNITS[match[2]];\n    if (order <= last) throw new RangeError('Invalid duration');\n    last = order;\n    total += BigInt(match[1]) * factor;\n    if (total > max) throw new RangeError('Duration too large');\n    pos = token.lastIndex;\n  }\n  end.lastIndex = pos;\n  if (last < 0 || !end.test(text)) throw new RangeError('Invalid duration');\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -6"}}}}}}
