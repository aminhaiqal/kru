{"phase":"measured","value":{"method":"item/started","params":{"threadId":"adc76ae1-0a79-45ea-a1b3-0f47566e598e","turnId":"c21eb586-730d-479a-9f0a-0cd5a41d492e","item":{"id":"toolu_01AkhyUhPStXXA2KgGm1M4i8","type":"commandExecution","text":"Bash","details":{"name":"Bash","input":{"command":"cat > src/duration.ts <<'EOF'\nconst UNIT_ORDER = ['h', 'm', 's', 'ms'] as const;\nconst UNIT_MS: Record<string, bigint> = {\n  h: 3600000n,\n  m: 60000n,\n  s: 1000n,\n  ms: 1n,\n};\n\nexport function parseDuration(text: string): number {\n  if (typeof text !== 'string') throw new RangeError('Invalid duration');\n  const max = BigInt(Number.MAX_SAFE_INTEGER);\n  const re = /(\\d+)(ms|h|m|s)(?:\\s+|(?=\\d)|$)/y;\n  let pos = text.match(/^\\s*/)![0].length;\n  if (pos >= text.length) throw new RangeError('Invalid duration');\n\n  let lastIndex = -1;\n  let total = 0n;\n  while (pos < text.length) {\n    re.lastIndex = pos;\n    const m = re.exec(text);\n    if (!m) throw new RangeError('Invalid duration');\n    const idx = UNIT_ORDER.indexOf(m[2] as (typeof UNIT_ORDER)[number]);\n    if (idx <= lastIndex) throw new RangeError('Invalid duration');\n    lastIndex = idx;\n    const value = BigInt(m[1]);\n    if (value > max) throw new RangeError('Duration too large');\n    total += value * UNIT_MS[m[2]];\n    if (total > max) throw new RangeError('Duration too large');\n    pos = re.lastIndex;\n  }\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -15"}}}}}}
