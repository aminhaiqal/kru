{"phase":"measured","value":{"method":"item/started","params":{"threadId":"75905c78-e61f-4919-b0f1-13d8514ba10a","turnId":"93d75f27-a8a3-4b22-a006-881bb081113f","item":{"id":"toolu_01LBwE3aQa7isHmjm4UiApP4","type":"commandExecution","text":"Bash","details":{"name":"Bash","input":{"command":"cat > src/duration.ts <<'E'\nconst PATTERN =\n  /^\\s*(?:(\\d+)h)?\\s*(?:(\\d+)m(?!s))?\\s*(?:(\\d+)s)?\\s*(?:(\\d+)ms)?\\s*$/;\nconst FACTORS = [3600000n, 60000n, 1000n, 1n];\nconst MAX = BigInt(Number.MAX_SAFE_INTEGER);\n\nexport function parseDuration(text: string): number {\n  const match = PATTERN.exec(text);\n  if (!match || match.slice(1).every((part) => part === undefined)) {\n    throw new RangeError('Invalid duration');\n  }\n  let total = 0n;\n  for (let i = 0; i < FACTORS.length; i++) {\n    const part = match[i + 1];\n    if (part !== undefined) total += BigInt(part) * FACTORS[i];\n    if (total > MAX) throw new RangeError('Duration exceeds MAX_SAFE_INTEGER');\n  }\n  return Number(total);\n}\nE\nbun test 2>&1 | tail -15"}}}}}}
