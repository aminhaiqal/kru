                "command": "cat > src/duration.ts <<'EOF'\nconst UNITS: readonly (readonly [string, bigint])[] = [\n  ['h', 3600000n],\n  ['m', 60000n],\n  ['s', 1000n],\n  ['ms', 1n],\n];\n\nexport function parseDuration(text: string): number {\n  if (typeof text !== 'string') throw new RangeError('Invalid duration');\n  const re = /\\s*(\\d+)(ms|h|m|s)/y;\n  const end = text.trimEnd().length;\n  let pos = 0;\n  let lastIndex = -1;\n  let total = 0n;\n  const max = BigInt(Number.MAX_SAFE_INTEGER);\n  // skip leading whitespace is handled by the sticky regex's \\s*\n  while (pos < end) {\n    re.lastIndex = pos;\n    const m = re.exec(text);\n    if (!m || re.lastIndex > end) throw new RangeError('Invalid duration');\n    const idx = UNITS.findIndex(([u]) => u === m[2]);\n    if (idx <= lastIndex) throw new RangeError('Invalid duration');\n    lastIndex = idx;\n    total += BigInt(m[1]) * UNITS[idx][1];\n    if (total > max) throw new RangeError('Duration exceeds MAX_SAFE_INTEGER');\n    pos = re.lastIndex;\n  }\n  if (lastIndex < 0) throw new RangeError('Invalid duration');\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -8"
