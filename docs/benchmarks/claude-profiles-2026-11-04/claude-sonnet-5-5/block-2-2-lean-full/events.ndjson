{"phase":"measured","value":{"method":"item/started","params":{"threadId":"48e65360-24aa-45e4-8cc3-36c201e3e7ac","turnId":"029f8e7d-3f54-4c8e-b392-4dbd00f5854a","item":{"id":"toolu_017p6p29ZPY7FGzsbYckdj6D","type":"commandExecution","text":"Bash","details":{"name":"Bash","input":{"command":"cat > src/duration.ts <<'EOF'\nconst UNIT_MS: Record<string, bigint> = {\n  h: 3600000n,\n  m: 60000n,\n  s: 1000n,\n  ms: 1n,\n};\nconst ORDER = ['h', 'm', 's', 'ms'];\nconst MAX = BigInt(Number.MAX_SAFE_INTEGER);\n\nexport function parseDuration(text: string): number {\n  if (typeof text !== 'string') throw new RangeError('Invalid duration');\n  const re = /\\s*(\\d+)(ms|h|m|s)/y;\n  let pos = 0;\n  let lastIndex = -1;\n  let total = 0n;\n  let count = 0;\n  while (pos < text.length) {\n    re.lastIndex = pos;\n    const match = re.exec(text);\n    if (!match) {\n      if (count > 0 && /^\\s*$/.test(text.slice(pos))) break;\n      throw new RangeError('Invalid duration');\n    }\n    const idx = ORDER.indexOf(match[2]);\n    if (idx <= lastIndex) throw new RangeError('Invalid duration');\n    lastIndex = idx;\n    const value = BigInt(match[1]);\n    if (value > MAX) throw new RangeError('Duration too large');\n    total += value * UNIT_MS[match[2]];\n    if (total > MAX) throw new RangeError('Duration too large');\n    count++;\n    pos = re.lastIndex;\n  }\n  if (count === 0) throw new RangeError('Invalid duration');\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -15"}}}}}}
