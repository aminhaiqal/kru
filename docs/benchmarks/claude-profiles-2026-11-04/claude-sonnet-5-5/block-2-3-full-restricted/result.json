              "name": "Bash",
              "input": {
                "command": "cat > src/duration.ts <<'EOF'\nconst UNITS = ['h', 'm', 's', 'ms'] as const;\nconst FACTORS: Record<(typeof UNITS)[number], number> = {\n  h: 3_600_000,\n  m: 60_000,\n  s: 1_000,\n  ms: 1,\n};\n\nexport function parseDuration(text: string): number {\n  if (typeof text !== 'string') throw new RangeError('Invalid duration');\n  const re = /\\s*(\\d+)\\s*(ms|h|m|s)/y;\n  const max = BigInt(Number.MAX_SAFE_INTEGER);\n  let pos = 0;\n  let lastIndex = -1;\n  let total = 0n;\n  let count = 0;\n  while (true) {\n    re.lastIndex = pos;\n    const match = re.exec(text);\n    if (!match) break;\n    const unit = match[2] as (typeof UNITS)[number];\n    const idx = UNITS.indexOf(unit);\n    if (idx <= lastIndex) throw new RangeError('Invalid duration');\n    lastIndex = idx;\n    total += BigInt(match[1]) * BigInt(FACTORS[unit]);\n    if (total > max) throw new RangeError('Duration too large');\n    pos = re.lastIndex;\n    count++;\n  }\n  if (count === 0 || !/^\\s*$/.test(text.slice(pos))) {\n    throw new RangeError('Invalid duration');\n  }\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -15"
              }
