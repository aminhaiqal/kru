                "command": "cat > src/duration.ts <<'EOF'\nconst PATTERN = /^(?:(\\d+)h)?\\s*(?:(\\d+)m(?!s))?\\s*(?:(\\d+)s)?\\s*(?:(\\d+)ms)?$/;\nconst FACTORS = [3600000n, 60000n, 1000n, 1n];\n\nexport function parseDuration(text: string): number {\n  const trimmed = typeof text === 'string' ? text.trim() : '';\n  const match = PATTERN.exec(trimmed);\n  if (!trimmed || !match) throw new RangeError('Invalid duration');\n  let total = 0n;\n  for (let i = 0; i < 4; i++) {\n    const part = match[i + 1];\n    if (part !== undefined) total += BigInt(part) * FACTORS[i];\n  }\n  if (total > BigInt(Number.MAX_SAFE_INTEGER)) throw new RangeError('Duration too large');\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -8"
