                "command": "cat > src/duration.ts <<'EOF'\nconst PATTERN = /^\\s*(?:(\\d+)h\\s*)?(?:(\\d+)m(?!s)\\s*)?(?:(\\d+)s\\s*)?(?:(\\d+)ms\\s*)?$/;\nconst FACTORS = [3600000n, 60000n, 1000n, 1n];\n\nexport function parseDuration(text: string): number {\n  const match = typeof text === 'string' ? PATTERN.exec(text) : null;\n  if (!match || match.slice(1).every((part) => part === undefined)) {\n    throw new RangeError('Invalid duration');\n  }\n  let total = 0n;\n  for (let i = 0; i < FACTORS.length; i++) {\n    const part = match[i + 1];\n    if (part !== undefined) total += BigInt(part) * FACTORS[i];\n  }\n  if (total > BigInt(Number.MAX_SAFE_INTEGER)) {\n    throw new RangeError('Duration exceeds Number.MAX_SAFE_INTEGER');\n  }\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -8"
