{"phase":"measured","value":{"method":"item/started","params":{"threadId":"a63f9147-587f-4750-a02a-83432c33ec77","turnId":"89dd83a8-7d6a-439e-9ed9-d66845e3fb91","item":{"id":"toolu_016bdCJH3UJhJWgVDiXARbNY","type":"commandExecution","text":"Bash","details":{"name":"Bash","input":{"command":"cat > src/duration.ts <<'EOF'\nconst PATTERN =\n  /^\\s*(?:(\\d+)h)?\\s*(?:(\\d+)m(?!s))?\\s*(?:(\\d+)s)?\\s*(?:(\\d+)ms)?\\s*$/;\n\nconst MULTIPLIERS = [3_600_000n, 60_000n, 1_000n, 1n];\n\nexport function parseDuration(text: string): number {\n  const match = typeof text === 'string' ? PATTERN.exec(text) : null;\n  if (!match || match.slice(1).every((part) => part === undefined)) {\n    throw new RangeError('Invalid duration');\n  }\n  let total = 0n;\n  for (let i = 0; i < MULTIPLIERS.length; i++) {\n    const part = match[i + 1];\n    if (part !== undefined) total += BigInt(part) * MULTIPLIERS[i];\n  }\n  if (total > BigInt(Number.MAX_SAFE_INTEGER)) {\n    throw new RangeError('Duration exceeds Number.MAX_SAFE_INTEGER');\n  }\n  return Number(total);\n}\nEOF\nbun test 2>&1 | tail -15"}}}}}}
