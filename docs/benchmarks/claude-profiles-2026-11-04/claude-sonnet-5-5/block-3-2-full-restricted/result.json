              "name": "Bash",
              "input": {
                "command": "cat > src/duration.ts <<'EOF'\nconst UNITS: Record<string, number> = { h: 3600000, m: 60000, s: 1000, ms: 1 };\nconst ORDER = ['h', 'm', 's', 'ms'];\n\nexport function parseDuration(text: string): number {\n  if (typeof text !== 'string') throw new RangeError('Invalid duration');\n  const re = /\\s*(\\d+)\\s*(ms|h|m|s)/y;\n  const end = text.trimEnd().length;\n  let pos = 0;\n  let lastIdx = -1;\n  let total = 0;\n  const skip = /^\\s*/.exec(text)![0].length;\n  if (skip >= end) throw new RangeError('Invalid duration');\n  while (pos < end) {\n    re.lastIndex = pos;\n    const m = re.exec(text);\n    if (!m || re.lastIndex > end) throw new RangeError('Invalid duration');\n    const idx = ORDER.indexOf(m[2]);\n    if (idx <= lastIdx) throw new RangeError('Invalid duration');\n    lastIdx = idx;\n    const n = Number(m[1]);\n    if (!Number.isSafeInteger(n)) throw new RangeError('Invalid duration');\n    total += n * UNITS[m[2]];\n    if (!Number.isSafeInteger(total)) throw new RangeError('Invalid duration');\n    pos = re.lastIndex;\n  }\n  return total;\n}\nEOF\nbun test 2>&1 | tail -15"
              }
            }
          }
        }
