{
  "name": "kru",
  "version": "0.0.3",
  "private": true,
  "description": "A local-first engine for persistent AI agent teammates",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kru": "./src/cli/index.ts"
  },
  "exports": {
    "./rpc": "./src/rpc/index.ts",
    "./providers": "./src/providers/index.ts",
    "./chat": "./src/chat/turn.ts"
  },
  "scripts": {
    "dev": "bun src/cli/index.ts",
    "test": "bun test",
    "test:codex": "KRU_TEST_CODEX=1 bun test test/codex-smoke.test.ts",
    "test:providers": "bun test test/providers.test.ts test/permissions.test.ts test/provider-runtime.test.ts test/provider-liveness.test.ts test/token-usage.test.ts",
    "test:codex-chat": "KRU_TEST_CODEX_CHAT=1 bun test test/provider-live.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "test:claude-chat": "KRU_TEST_CLAUDE_CHAT=1 bun test test/claude-live.test.ts",
    "test:permissions-live": "KRU_TEST_PERMISSIONS=1 bun test test/permissions-live.test.ts",
    "benchmark:claude-profiles": "CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 bun scripts/claude-profile-benchmark.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "zod": "^4.6.7"
  }
}
