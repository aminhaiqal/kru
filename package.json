{
  "name": "kru",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first engine for persistent AI agent teammates",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kru": "./src/cli/index.ts"
  },
  "exports": {
    "./rpc": "./src/rpc/index.ts",
    "./providers": "./src/providers/index.ts",
    "./chat": "./src/chat/turn.ts",
    "./store": "./src/store/index.ts",
    "./agents": "./src/agents/index.ts",
    "./mailbox": "./src/mailbox/index.ts",
    "./scheduler": "./src/scheduler/index.ts",
    "./daemon": "./src/daemon/index.ts",
    "./usage": "./src/usage/index.ts",
    "./turns": "./src/turns/index.ts",
    "./cost": "./src/cost/prices.ts",
    "./tools": "./src/tools/index.ts"
  },
  "scripts": {
    "dev": "bun src/cli/index.ts",
    "test": "bun test",
    "test:codex": "KRU_TEST_CODEX=1 bun test test/codex-smoke.test.ts",
    "test:providers": "bun test test/providers.test.ts test/permissions.test.ts test/provider-runtime.test.ts test/provider-liveness.test.ts test/token-usage.test.ts",
    "test:codex-chat": "KRU_TEST_CODEX_CHAT=1 bun test test/provider-live.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "test:claude-chat": "KRU_TEST_CLAUDE_CHAT=1 bun test test/claude-live.test.ts",
    "test:permissions-live": "KRU_TEST_PERMISSIONS=1 bun test test/permissions-live.test.ts",
    "test:shell-parity-live": "bun scripts/check-shell-parity.ts",
    "benchmark:claude-profiles": "CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 bun scripts/claude-profile-benchmark.ts",
    "test:mailbox": "bun test test/mailbox.test.ts test/mailbox-cli.test.ts test/store.test.ts",
    "test:mailbox:repeat": "bun test --rerun-each 10 test/mailbox.test.ts test/mailbox-cli.test.ts test/store.test.ts",
    "test:scheduler": "bun test test/scheduler.test.ts test/mailbox-batch.test.ts test/scheduler-cli.test.ts test/store.test.ts test/codex-retirement.test.ts test/budget-day.test.ts test/pricing.test.ts test/usage-ledger.test.ts",
    "test:scheduler:repeat": "bun test --rerun-each 10 test/scheduler.test.ts test/mailbox-batch.test.ts test/scheduler-cli.test.ts test/store.test.ts test/codex-retirement.test.ts test/budget-day.test.ts test/pricing.test.ts test/usage-ledger.test.ts",
    "test:usage": "bun test test/pricing.test.ts test/usage-ledger.test.ts test/token-usage.test.ts",
    "test:history": "bun test test/events.test.ts test/history-cli.test.ts",
    "test:history:repeat": "bun test --rerun-each 10 test/events.test.ts test/history-cli.test.ts",
    "test:messaging": "bun test test/messaging.test.ts test/messaging-providers.test.ts",
    "test:messaging:repeat": "bun test --rerun-each 10 test/messaging.test.ts test/messaging-providers.test.ts",
    "demo:messaging": "bun scripts/demo-messaging.ts",
    "test:release:repeat": "bun test --rerun-each 10 test/release.test.ts test/messaging.test.ts test/messaging-providers.test.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "zod": "^4.6.7"
  }
}
